{"task_id": "tpch_031", "nl_request": "Show monthly order counts in 1996.", "dbt_project": "third_party/tpch_duckdb", "schema_context": {"models": ["line_items", "orders"], "columns": {"line_items": ["line_item_id", "order_id", "ship_date", "quantity", "extended_price", "discount", "revenue", "return_flag", "market_segment", "nation"], "orders": ["order_id", "order_key", "order_date", "order_status", "order_priority", "total_price", "market_segment", "customer_name", "nation"]}}, "expected_semantic": {"base_measure": "order_count", "group_by": ["order_date"], "time_granularity": "month", "filters": ["order_date in 1996"], "aggregation": "count"}, "gold_sql": "SELECT date_trunc('month', order_date) AS m, COUNT(*) AS n FROM main.orders WHERE order_date BETWEEN '1996-01-01' AND '1996-12-31' GROUP BY 1 ORDER BY 1", "compare_rules": {"ordering": "set", "column_agnostic": true}, "difficulty": "moderate", "ambiguity": "medium", "ambiguity_class": "determinable"}
